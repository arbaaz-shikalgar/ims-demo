# Production env for SendGrid
NODE_ENV=production
# SendGrid API Key (preferred)
SENDGRID_API_KEY=SG.YOUR_API_KEY_HERE

# If you prefer SMTP with SendGrid (alternative):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY

# Optional: SMTP settings for other providers (Mailgun, etc.)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=username
# SMTP_PASS=password
